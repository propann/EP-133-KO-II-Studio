{
  "name": "ep133-ko-ii-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "test": "npm run test:engine && npm run test:transport && npm run test:exports && npm run test:wav && npm run test:convert && npm run test:targets && npm run test:profile && npm run test:unit",
    "test:exports": "node --experimental-strip-types tools/check-project-exports.mjs",
    "test:transport": "node --experimental-strip-types tools/check-transport.mjs",
    "test:engine": "node --experimental-strip-types tools/check-engine.mjs",
    "test:wav": "node --experimental-strip-types tools/check-wav-analysis.mjs",
    "test:convert": "node --experimental-strip-types tools/check-wav-convert.mjs",
    "test:targets": "node --experimental-strip-types tools/check-ep133-targets.mjs",
    "test:profile": "node --experimental-strip-types tools/check-player-profile.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "^2.1.2",
    "@vitejs/plugin-react": "^6.0.5",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tone": "^15.1.22",
    "vite": "^8.2.0",
    "wavesurfer.js": "^7.12.11",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
